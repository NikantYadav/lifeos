# Vercel KV / Upstash Redis credentials.
# When you add the "Vercel KV" (Upstash Redis) integration from the Vercel
# Marketplace and link it to this project, these are injected automatically
# in production and preview. For local development, run:
#   vercel env pull .env.local
# or copy the values from the Vercel dashboard / Upstash console.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Single-user login. The state blob holds an approach log, named contacts and
# weight history, so a public deployment should always set these three.
# LIFEOS_EMAIL / LIFEOS_PASSWORD are the one valid credential pair.
# AUTH_SECRET is a separate random key used to sign the session cookie (HMAC)
# — it must NOT be the same value as the password. Generate one with:
#   openssl rand -hex 32
LIFEOS_EMAIL=
LIFEOS_PASSWORD=
AUTH_SECRET=

# Google Gemini API key (Google AI Studio), for the Sunday review. Get one at
# https://aistudio.google.com/apikey. Leave empty to disable the review call.
GEMINI_API_KEY=
# Optional override if the default model id in src/lib/gemini.ts is retired.
GEMINI_MODEL=
