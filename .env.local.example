# Vercel KV / Upstash Redis credentials.
# When you add the "Vercel KV" (Upstash Redis) integration from the Vercel
# Marketplace and link it to this project, these are injected automatically
# in production and preview. For local development, run:
#   vercel env pull .env.local
# or copy the values from the Vercel dashboard / Upstash console.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Single-user login. The state blob holds an approach log, named contacts and
# weight history, so a public deployment should always set these three.
# LIFEOS_EMAIL / LIFEOS_PASSWORD are the one valid credential pair.
# AUTH_SECRET is a separate random key used to sign the session cookie (HMAC)
# — it must NOT be the same value as the password. Generate one with:
#   openssl rand -hex 32
LIFEOS_EMAIL=
LIFEOS_PASSWORD=
AUTH_SECRET=

# Google Gemini API key (Google AI Studio), for the Sunday review. Get one at
# https://aistudio.google.com/apikey. Leave empty to disable the review call.
GEMINI_API_KEY=
# Optional override if the default model id in src/lib/gemini.ts is retired.
GEMINI_MODEL=

# Web Push (VAPID key pair), for install-and-notify support. Generate a pair
# with `npx web-push generate-vapid-keys` and paste the two keys below.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY ships to the browser; VAPID_PRIVATE_KEY must
# stay server-only. VAPID_SUBJECT is a mailto: or https: contact URL some push
# services require. Leave all three empty to disable push (install still works).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Shared secret for the scheduled reminder job (see vercel.json's cron entry
# for /api/push/cron). Vercel Cron sends this back as an Authorization: Bearer
# header, so it must match the CRON_SECRET set in the Vercel project's env
# vars in production. Generate one with `openssl rand -hex 32`. Leave empty to
# disable the daily/Sunday reminder job (manual push via /api/push/send still
# works without it).
CRON_SECRET=
