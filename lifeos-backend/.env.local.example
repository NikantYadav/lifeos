# Supabase — SERVICE ROLE key only. This backend is the one place in the
# whole LifeOS project allowed to hold this key. Never put it in
# lifeos-frontend, never prefix it with NEXT_PUBLIC_, never log it.
# Find both values in the Supabase dashboard: Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (Google AI Studio), for the AI onboarding chat and
# the Sunday/daily accountability review. Get one at
# https://aistudio.google.com/apikey. Leave empty to disable AI features.
GEMINI_API_KEY=
# REQUIRED when GEMINI_API_KEY is set — lib/ai/gemini.ts has no built-in
# default and throws if this is empty while a key is present. List models
# available to your key at https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
# if this model id is ever retired.
GEMINI_MODEL=gemini-3.5-flash

# Subscription billing (7-day trial -> paid). Populate once the billing
# integration (RevenueCat or direct Google Play Billing server notifications)
# is wired up — see ROADMAP.md Phase "billing".
REVENUECAT_WEBHOOK_SECRET=

# Sentry error tracking (ROADMAP.md Phase 6, "Monitoring/error tracking").
# Optional — leave empty to disable. When unset, lib/monitoring.ts's
# isSentryEnabled() returns false, sentry.server.config.ts/sentry.edge.config.ts
# skip Sentry.init() entirely, and withApi's catch block (lib/apiRoute.ts)
# still logs + returns the same error response as always — Sentry is purely
# additive, never required for the app to function. Get a DSN by creating a
# project at https://sentry.io once a real Sentry account exists (none does
# yet as of this writing).
SENTRY_DSN=
