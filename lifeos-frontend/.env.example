# Publishable/anon key only — this is safe to embed on-device (Supabase Auth's
# own endpoints are designed for it) and is the ONLY Supabase credential this
# app ever holds. It is used exclusively for auth (see src/lib/supabase.ts);
# no `public.*` table is ever read/written directly from this app. All data
# operations go through lifeos-backend instead — see src/lib/api.ts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# lifeos-backend's base URL. Use your machine's LAN IP (not localhost) when
# testing on a physical device or emulator, e.g. http://192.168.1.23:3000.
EXPO_PUBLIC_API_BASE_URL=
